// 由 integration/desktops.json 生成；只编辑结构定义，不手改产物。
// 原生 alpha 接入；重构后已通过公开面板烟测，实体组合键、真实取词／翻译／粘贴闭环、应用与多屏矩阵仍待验收。手工合并，禁止覆盖整个配置或重复创建 binds 块。
// 程序须能由 PATH 找到；不会自动写入用户桌面配置。

spawn-at-startup "glosslet"

// 原生面板是 Overlay 浮动覆盖层，不使用普通窗口的 open-floating。
layer-rule {
    match namespace="^glosslet$"
    opacity 1.0
    shadow { off; }
    background-effect { blur false; }
}

binds {
    Mod+Shift+G repeat=false { spawn "glosslet" "lookup"; }
}
